def solution(A):
    #Create variables for max and min with values at the upper and lower bounds
    max1 = max2 = max3 = -1001
    min1 = min2 = 1001
    
    for num in A:
        #If num is greater than a max, let all the other max values take in the previous one
        if num > max1:
            max3, max2, max1 = max2, max1, num
        elif num > max2:
            max3, max2 = max2, num
        elif num > max3:
            max3 = num
            
        #If num is smaller than a min, let all the other min values take in the previous one
        if num < min1:
            min2, min1 = min1, num
        elif num < min2:
            min2 = num
    #Create two products, one for the 3 of the largest numbers and the other 2 of the smallest numbers and the largest        
    product1 = max1 * max2 * max3
    product2 = min1 * min2 * max1

    return max(product1, product2)
